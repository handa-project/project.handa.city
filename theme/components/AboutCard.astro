---
// HAnDA: トップの ABOUT 欄で、HAnDAプロジェクトとはの下に並べるカード（半田市とは・赤レンガ建物とは など）。
//   - 写真を貼ると最初の 1 枚がカードの上に出る（無ければロゴ）
//   - 文章は Cosense の区切り線（ーーーーー）より上だけ
//   - カードを押すと、概要ページの該当する見出しへ
import type { CollectionEntry } from "astro:content";
import { splitAtSeparator } from "../lib/separator";

interface Props {
  entry: CollectionEntry<"pages">;
  href: string;
}
const { entry, href } = Astro.props;
const image = entry.data.image;
type Inline = { type: string; value?: string; title?: string; href?: string; children?: Inline[] };
type Block = { type: string; url?: string; children?: Inline[] };
const { before } = splitAtSeparator(entry.data.blocks as unknown as Block[]);
// カード全体がリンクなので、中は文字だけにする（リンクは入れ子にできない）
const plain = (nodes?: Inline[]): string =>
  (nodes ?? [])
    .map((n) => (n.type === "text" || n.type === "code" ? n.value ?? "" : n.type === "pageLink" ? n.title ?? "" : n.type === "tag" || n.type === "link" ? "" : plain(n.children)))
    .join("");
const text = before
  .filter((b) => b.type === "paragraph" || b.type === "list")
  .map((b) => plain(b.children).trim())
  .filter(Boolean)
  .join(" ");
const placeholder = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/card-placeholder.png`;
---
<a class="about-card" href={href}>
  <span class="about-card-thumb">
    {image
      ? <img src={image} alt="" loading="lazy" decoding="async" />
      : <img class="is-placeholder" src={placeholder} alt="" aria-hidden="true" loading="lazy" />}
  </span>
  <span class="about-card-body">
    <span class="about-card-title">{entry.data.title}</span>
    {text && <span class="about-card-text">{text}</span>}
  </span>
</a>

<style>
  .about-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .about-card:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.06);
  }
  .about-card-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-soft);
    overflow: hidden;
  }
  .about-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }
  .about-card-thumb img.is-placeholder {
    width: auto;
    height: 2.6rem;
    object-fit: contain;
    opacity: 0.9;
  }
  .about-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.15rem 1.15rem;
  }
  .about-card-title {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
  }
  /* 紹介文は 3 行まで */
  .about-card-text {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* 広い画面では 横長（左に写真、右に文章） */
  @media (min-width: 721px) {
    .about-card { flex-direction: row; }
    .about-card-thumb { flex: 0 0 44%; aspect-ratio: 4 / 3; }
    .about-card-body { justify-content: center; padding: 1.5rem 1.75rem; gap: 0.6rem; }
    .about-card-title { font-size: 1.2rem; }
    .about-card-text { -webkit-line-clamp: 5; font-size: 0.92rem; }
  }
</style>
