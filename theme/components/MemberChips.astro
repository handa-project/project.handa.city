---
// HAnDA: メンバーの役職・学科・学年を小さなラベル（チップ）で並べる。値はタグから（lib/members.ts の memberInfo）
//   - 地の色なし・細い線の控えめなラベル。学科だけ文字を赤に
//   - 一覧（members.astro）は学科ごとに見出しがあるので学科のチップを出さない（showDept={false}）
import { gradeText } from "../lib/members";

interface Props {
  dept?: string;
  grade?: string; // B3・M1 など
  role?: string;
  showDept?: boolean;
  size?: "sm" | "md";
}
const { dept, grade, role, showDept = true, size = "sm" } = Astro.props;
const m = grade?.match(/^([BMD])(\d)$/);
const kind = m?.[1].toLowerCase();
const n = m ? Math.min(Number(m[2]), 4) : 0;
---
{(role || (showDept && dept) || grade) && (
  <span class:list={["mchips", `mchips--${size}`]}>
    {role && <span class="mchip mchip--role">{role}</span>}
    {showDept && dept && <span class="mchip mchip--dept">{dept}</span>}
    {grade && <span class:list={["mchip", "mchip--grade", kind && `mchip--${kind}`]} style={n ? `--g:${n}` : undefined}>{gradeText(grade)}</span>}
  </span>
)}

<style>
  /* ごく控えめな四角いラベル：地の色なし・細い線・小さめの文字。学科だけ文字を赤にする */
  .mchips { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.2rem; }
  .mchip {
    display: inline-flex;
    align-items: center;
    padding: 0 0.35rem;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
    font-size: 0.66rem;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--color-text-muted);
  }
  .mchips--md .mchip { font-size: 0.76rem; padding: 0 0.45rem; }
  /* 役職（代表など）だけ少し目立たせる：薄い赤の地に赤い文字 */
  .mchip--role { color: #b3142a; background: color-mix(in srgb, var(--color-accent) 12%, #fff); font-weight: 600; box-shadow: none; }
  .mchip--dept { color: color-mix(in srgb, var(--color-accent) 80%, #666); }
</style>
