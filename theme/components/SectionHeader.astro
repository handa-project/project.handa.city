---
// HAnDA: 各一覧ページ・固定ページの先頭に出す共通の見出し。
// 小さな英語ラベル（赤）＋ 大きな日本語タイトル ＋ 説明文。
// Members / Blog / Works / Contact / About で同じ見た目になる。
interface Props {
  en?: string;
  title: string;
  lead?: string;
  /** トップページ内で使うとき（h1 ではなく h2 にする） */
  as?: "h1" | "h2";
  /** 指定すると、見出し全体がそのページへのリンクになり、右側に矢印が出る */
  href?: string;
}
const { en, title, lead, as = "h1", href } = Astro.props;
const Tag = as;
const showEn = en && en !== title;
---
<header class:list={["section-header", { "is-sub": as === "h2", "is-link": !!href }]}>
  {href ? (
    <a class="section-link" href={href}>
      <span class="section-link-text">
        {showEn && <span class="section-eyebrow">{en}</span>}
        <Tag class="section-title">{title}</Tag>
      </span>
      <span class="section-arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <Fragment>
      {showEn && <p class="section-eyebrow">{en}</p>}
      <Tag class="section-title">{title}</Tag>
    </Fragment>
  )}
  {lead && <p class="section-lead">{lead}</p>}
  <slot />
</header>

<style>
  .section-header {
    margin-top: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .section-header.is-sub {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }
  .section-eyebrow {
    display: block;
    margin: 0 0 0.35rem;
    font-family: "Oswald", var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .section-title {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.25;
  }
  .is-sub .section-title {
    font-size: 1.6rem;
  }
  /* 見出しがリンクのとき：右側に矢印 */
  .section-link {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .section-link:hover { text-decoration: none; }
  .section-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    font-size: 1.1rem;
    transition: background 0.15s var(--ease), color 0.15s var(--ease), transform 0.15s var(--ease);
  }
  .section-link:hover .section-arrow { background: var(--color-accent); color: #fff; transform: translateX(3px); }
  .section-link:hover .section-title { color: var(--color-accent); }
  .section-lead {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  @media (max-width: 720px) {
    .section-title { font-size: 1.85rem; }
    .is-sub .section-title { font-size: 1.4rem; }
  }
</style>
