---
import site from "virtual:cosense-site-kit/site";
import options from "virtual:cosense-theme-default/options";
import { loadTitleToSlug, navHref } from "@cosense-site-kit/theme-utils";
import { loadStructure } from "../lib/config";
import Search from "./Search.astro";
import { splitLabel } from "../lib/sections";

// HAnDA: public/logo.png があればサイト名の代わりにロゴ画像を出す
import { existsSync } from "node:fs";
import { join } from "node:path";
const hasLogo = existsSync(join(process.cwd(), "public", "logo.png"));
const logoSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/logo.png`;

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const siteTitle =
  options.siteTitle ?? site?.title ?? (Astro.site ? new URL("/", Astro.site).hostname : "Site");

const structure = await loadStructure();
const navItems = structure.nav.length > 0 ? structure.nav : options.nav;
const titleToSlug = await loadTitleToSlug();

const isActive = (href: string): boolean => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---
{/* HAnDA: has-js は最初から付けておく。スクリプトで後から付けると、ページを移るたびに
    検索ボタンが一瞬消えてから出て、メニューが左右にがたつくため（JS が無いときは下の noscript で元に戻す） */}
<header class="site-header has-js">
  <noscript><style>
    .site-header.has-js .site-search-toggle, .site-header.has-js .site-nav-toggle { display: none !important; }
    .site-header.has-js .site-nav-wrap { position: static !important; display: block !important; visibility: visible !important; opacity: 1 !important; transform: none !important; clip-path: none !important; pointer-events: auto !important; box-shadow: none !important; }
    .site-header.has-js .site-nav li { opacity: 1 !important; transform: none !important; }
  </style></noscript>
  <div class="site-header-inner">
    <a class="site-brand" href={import.meta.env.BASE_URL}>
      {hasLogo ? <img class="site-logo" src={logoSrc} alt={siteTitle} /> : siteTitle}
    </a>

    {navItems.length > 0 && (
      <Fragment>
        <button
          type="button"
          class="site-nav-toggle"
          aria-label="Toggle navigation"
          aria-controls="site-nav-wrap"
          aria-expanded="false"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line class="bar bar-1" x1="3" y1="6" x2="21" y2="6" />
            <line class="bar bar-2" x1="3" y1="12" x2="21" y2="12" />
            <line class="bar bar-3" x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <nav class="site-nav-wrap" id="site-nav-wrap" aria-label="Primary">
          <ul class="site-nav">
            {navItems.map((item) => {
              const href = navHref(item, titleToSlug);
              // HAnDA: 「英語|日本語」なら2段表示
              const { en, ja } = splitLabel(item.label);
              return (
                <li>
                  <a href={href} class:list={[{ "is-active": isActive(href) }]}>
                    {en === ja ? item.label : (
                      <Fragment><span class="nav-en">{en}</span><span class="nav-ja">{ja}</span></Fragment>
                    )}
                    {/* HAnDA: いまのページを示す青い線。ページを移るとき次のメニューへ滑っていく */}
                    <span class="nav-mark" aria-hidden="true"></span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </Fragment>
    )}

    {/* Search icon sits at the far right of the bar. */}
    {options.search && <Search />}
  </div>
</header>

<script>
  import { trapFocus } from "../scripts/focus-trap";

  // Header behaviour, progressively enhanced. `has-js` gates the collapsed
  // layouts so without JS the nav stays visible (wrapped) and the search icon
  // is hidden (search needs JS + a built index anyway). The search UI itself is
  // the body-level #site-search-overlay (rendered by Layout); the header icon
  // just opens it.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    header.classList.add("has-js");

    const navToggle = header.querySelector<HTMLButtonElement>(".site-nav-toggle");
    const navWrap = header.querySelector<HTMLElement>(".site-nav-wrap");
    const searchTrigger = header.querySelector<HTMLButtonElement>("#site-search-trigger");
    const overlay = document.getElementById("site-search-overlay");
    const backdrop = overlay?.querySelector<HTMLElement>(".search-overlay-backdrop") ?? null;
    const box = overlay?.querySelector<HTMLElement>(".search-box") ?? null;
    const note = overlay?.querySelector<HTMLElement>(".search-box-note") ?? null;
    const bundlePath = overlay?.dataset.bundlePath ?? "/pagefind/";

    const setNav = (open: boolean) => {
      navWrap?.classList.toggle("is-open", open);
      navToggle?.setAttribute("aria-expanded", String(open));
    };
    const focusInput = () =>
      requestAnimationFrame(() => overlay?.querySelector("input")?.focus());
    // Focus trap so Tab stays inside the open dialog; released on close.
    let releaseTrap: (() => void) | null = null;
    const setSearch = (open: boolean) => {
      if (!overlay) return;
      const wasOpen = overlay.classList.contains("is-open");
      if (open && box && searchTrigger) {
        // Pin the box over the icon so it grows out of the button.
        const r = searchTrigger.getBoundingClientRect();
        box.style.top = `${r.top}px`;
        box.style.right = `${window.innerWidth - r.right}px`;
      }
      overlay.classList.toggle("is-open", open);
      searchTrigger?.setAttribute("aria-expanded", String(open));
      if (open) {
        loadSearch();
        focusInput();
        if (box) releaseTrap = trapFocus(box);
      } else {
        releaseTrap?.();
        releaseTrap = null;
        // Return focus to the trigger only if we actually closed an open
        // overlay; otherwise a stray Escape (e.g. closing the nav) would yank
        // focus to the search icon. Without this, focus falls to <body> because
        // the overlay becomes visibility:hidden.
        if (wasOpen) searchTrigger?.focus();
      }
    };

    // Lazy-load the Pagefind UI the first time search is opened. If the bundle
    // isn't there (e.g. `astro dev` before a build), show the note instead.
    let searchRequested = false;
    const loadSearch = () => {
      if (searchRequested) return;
      searchRequested = true;
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = `${bundlePath}pagefind-ui.css`;
      document.head.appendChild(link);
      const script = document.createElement("script");
      script.src = `${bundlePath}pagefind-ui.js`;
      script.addEventListener("load", () => {
        const Ctor = (window as unknown as { PagefindUI?: new (o: unknown) => unknown }).PagefindUI;
        if (typeof Ctor === "function") {
          new Ctor({
            element: "#cosense-search",
            bundlePath,
            showImages: false,
            showSubResults: true,
            translations: { placeholder: "サイト内を検索" },
          });
          focusInput();
        } else if (note) {
          note.hidden = false;
        }
      });
      script.addEventListener("error", () => {
        if (note) note.hidden = false;
      });
      document.head.appendChild(script);
    };

    navToggle?.addEventListener("click", () => {
      setNav(!navWrap?.classList.contains("is-open"));
    });
    searchTrigger?.addEventListener("click", () => {
      const open = !overlay?.classList.contains("is-open");
      setNav(false);
      setSearch(open);
    });
    backdrop?.addEventListener("click", () => setSearch(false));
    navWrap?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setNav(false);
    });
    document.addEventListener("keydown", (e) => {
      // Ignore Escape fired to cancel an IME conversion — otherwise typing
      // Japanese in the search box and pressing Esc to undo a conversion would
      // close the whole overlay and discard the query.
      if (e.isComposing || e.keyCode === 229) return;
      if (e.key === "Escape") {
        setNav(false);
        setSearch(false);
      }
    });
    // ── HAnDA：画面遷移の手ごたえ ────────────────────────────────
    // 1) メニューを押した位置から赤い波紋が広がる
    // 2) 押したら、いまのページの赤い線が押したメニューへ滑り出す
    //    （続きは次のページで view transition が引き継いで、ぴたりと止まる）
    // 3) 下へスクロールするとメニューバーを上へ隠し、上へスクロールすると出す
    const navList = header.querySelector<HTMLElement>(".site-nav");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isDesktop = window.matchMedia("(min-width: 721px)");

    navList?.addEventListener("pointerdown", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a");
      if (!a || reduceMotion.matches) return;
      const r = a.getBoundingClientRect();
      a.style.setProperty("--rx", `${e.clientX - r.left}px`);
      a.style.setProperty("--ry", `${e.clientY - r.top}px`);
      a.classList.remove("is-rippling");
      void a.offsetWidth; // 連打でも毎回最初から再生する
      a.classList.add("is-rippling");
    });
    navList?.addEventListener("animationend", (e) => {
      (e.target as HTMLElement).closest("a")?.classList.remove("is-rippling");
    });

    const slideMark = (to: HTMLAnchorElement) => {
      if (!navList || !isDesktop.matches) return;
      const from = navList.querySelector<HTMLAnchorElement>("a.is-active");
      if (!from || from === to) return;
      const mark = from.querySelector<HTMLElement>(".nav-mark");
      if (!mark) return;
      const a = from.getBoundingClientRect();
      const b = to.getBoundingClientRect();
      const dx = b.left + b.width / 2 - (a.left + a.width / 2);
      mark.style.transform = `translateX(${dx}px) scaleX(${b.width / a.width})`;
    };

    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href]");
      if (!a || a.hasAttribute("download")) return;
      if (a.target && a.target !== "_self") return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return;
      // 同じページ内のジャンプ（#目次など）や、いま開いているページは対象外
      if (url.pathname === location.pathname && url.search === location.search) return;
      document.documentElement.classList.add("is-leaving");
      a.classList.add("is-going");
      if (a.closest(".site-nav")) slideMark(a);
    });
    // 「戻る」でキャッシュから復元されたときは、押した状態を元に戻す
    window.addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      document.documentElement.classList.remove("is-leaving");
      document.querySelectorAll(".is-going").forEach((el) => el.classList.remove("is-going"));
      header.querySelectorAll<HTMLElement>(".nav-mark").forEach((el) => (el.style.transform = ""));
    });

    document.addEventListener("click", (e) => {
      // Close the nav menu on an outside click. The search overlay closes via
      // its own backdrop, so leave it alone here.
      const target = e.target as Node;
      if (!header.contains(target) && !overlay?.contains(target)) setNav(false);
    });

    // ── HAnDA：スクロールの向きでメニューバーを出し入れ ─────────────
    // 下へ読み進めている間は隠して画面を広く使い、少しでも上へ戻したら出す。
    // ページの一番上の近く・メニューや検索を開いている間・キーボードで
    // メニューバーを操作している間は、いつも出しておく
    // 同じ向きにある程度進んでから切り替える（指の小さな揺れや、端での跳ね返りで出たり消えたりしないように）
    let lastY = window.scrollY;
    let travel = 0; // 同じ向きに進んだ距離（下向きが正）
    const SHOW_NEAR_TOP = 120; // ここより上では隠さない（px）
    const HIDE_AFTER = 28; // 下へこれだけ進んだら隠す
    // 上へこれだけ戻したら出す（スマホは指で少し戻しただけで素早く出す）
    const SHOW_AFTER = window.matchMedia("(max-width: 720px)").matches ? 6 : 14;
    const setHidden = (hide: boolean) => header.classList.toggle("is-hidden", hide);
    const keepShown = () =>
      window.scrollY < SHOW_NEAR_TOP ||
      !!navWrap?.classList.contains("is-open") ||
      !!overlay?.classList.contains("is-open") ||
      !!header.querySelector(":focus-visible");
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const dy = y - lastY;
        lastY = y;
        // ページの上端・下端を越えた跳ね返り（スマホ・Mac）の分は数えない
        if (y < 0 || y > max) return;
        if (keepShown()) {
          travel = 0;
          return setHidden(false);
        }
        travel = Math.sign(dy) === Math.sign(travel) ? travel + dy : dy;
        if (travel > HIDE_AFTER) setHidden(true);
        else if (travel < -SHOW_AFTER) setHidden(false);
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => setHidden(false));
    // ページを開いた直後は動きを止めておき、表示が落ち着いてから出し入れの動きを有効にする（handa.css の is-ready）
    const ready = () => requestAnimationFrame(() => requestAnimationFrame(() => header.classList.add("is-ready")));
    if (document.readyState === "complete") ready();
    else window.addEventListener("load", ready, { once: true });
    // 「戻る」でキャッシュから復元されたときは出した状態から
    window.addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      lastY = window.scrollY;
      travel = 0;
      setHidden(false);
    });
  }
</script>
