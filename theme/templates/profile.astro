---
import type { CollectionEntry } from "astro:content";
import PageContent from "../components/Content.astro"; // HAnDA: 外部 URL をリンクカードにする版
import BackLink from "../components/BackLink.astro";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WorkChips from "../components/WorkChips.astro";
import MemberChips from "../components/MemberChips.astro";
import { MEMBER_TAG, backLinkFor, loadSections, worksForMember } from "../lib/sections";
import { displayName, memberInfo } from "../lib/members";

// Profile template: a slim hero band over the body, no tag chips, and a
// "more pages" footer pointing back into the rest of the site. Suitable for
// About / Members / Bio pages.
//
// Opt in by tagging the Cosense page with `#template/profile`, or by mapping
// the title in `.site` site.yaml:
//
//   templates:
//     "About Me": profile

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const page = entry.data;
// HAnDA: ナビに載っているページなら英語ラベルを、詳細ページなら一覧へ戻るリンクを出す
const navSection = (await loadSections()).find((s) => s.entry?.data.slug === page.slug);
const back = await backLinkFor(page.tags);
// メンバーページなら、関わった活動・成果をタグで出す
const isMember = page.tags.some((t) => MEMBER_TAG.test(t));
const memberWorks = isMember ? await worksForMember(entry) : [];
// 見出しに出す名前（メンバーは名前の後ろの（学科）などを出さない）
const heading = isMember ? displayName(page.title) : page.title;

// メンバーページ：サイトに出すのは 名前・学科と学年・役職（タグから）・最初の写真 1 枚・関わった活動 だけ。
// 本文の文章やコード（UserScript の読み込みなど）は、何が書いてあってもサイトには出さない（lib/members.ts）
const info = isMember ? memberInfo(page.tags) : undefined;
const lead = info ? [info.role, info.line].filter(Boolean).join("・") || undefined : undefined;
type ImageBlock = { type: "image"; url: string; href?: string };
const firstImage = (): ImageBlock | undefined => {
  const b = page.blocks.find((b) => b.type === "image") as ImageBlock | undefined;
  if (b) return { type: "image", url: b.url };
  return page.image ? { type: "image", url: page.image } : undefined;
};
const photo = isMember ? firstImage() : undefined;
const blocks = isMember ? (photo ? [photo] : []) : page.blocks;
const description = isMember ? lead : page.summary;
---
<Layout title={heading} description={description} image={page.image} ogType="article" sourceUrl={page.sourceUrl}>
  <article class="profile" data-pagefind-body>
    <BackLink back={back} />
    <SectionHeader en={navSection?.en ?? back?.en} title={heading}>
      {info && <div class="profile-chips"><MemberChips role={info.role} dept={info.dept} grade={info.grade} size="md" /></div>}
    </SectionHeader>

    {blocks.length > 0 && <PageContent blocks={blocks as typeof page.blocks} />}

    {/* メンバーページ：関わった活動（名前・写真・本文の下に表示） */}
    {memberWorks.length > 0 && (
      <div class="profile-works"><WorkChips works={memberWorks} label="Works" /></div>
    )}

    {/* 一覧へ戻るリンクは左上（BackLink）の1つだけ。Cosense の元ページへのリンクはフッターに出す */}
  </article>
</Layout>

<style>
  .profile-chips { margin-top: 0.75rem; }
  .profile-works { margin: 2rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--color-divider); }
  .profile-hero {
    text-align: center;
    padding: 2.5rem 1rem 2rem;
    border-bottom: 1px solid var(--color-divider);
    margin-bottom: 2.5rem;
  }
  .profile-hero h1 {
    font-size: 2.5rem;
    margin: 0 0 0.625rem;
    letter-spacing: 0.06em;
  }
  .profile-summary {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    max-width: 36rem;
    margin: 0 auto;
    line-height: 1.55;
  }
</style>
