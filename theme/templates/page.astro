---
import type { CollectionEntry } from "astro:content";
import { vtName } from "@cosense-site-kit/theme-utils";
import Backlinks from "@cosense-site-kit/theme-utils/components/Backlinks.astro";
import PageContent from "../components/Content.astro"; // HAnDA: 外部 URL をリンクカードにする版
import PageMeta from "@cosense-site-kit/theme-utils/components/PageMeta.astro";
import Related from "@cosense-site-kit/theme-utils/components/Related.astro";
import BackLink from "../components/BackLink.astro";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { backLinkFor, isWorksPage, loadSections } from "../lib/sections";
import { getCollection } from "astro:content";
import { loadAboutMore } from "../lib/about";
import { handaConfig } from "../lib/config";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const page = entry.data;

// HAnDA: 日付は公開日だけを表示する（更新日は出さない）。
// The date row (which dates show, and `#no-date` opting out of them) is
// PageMeta's job. Tags are not summarised here: the page's `#tag`s already
// render inline in the body (PageContent), so a header chip row would duplicate
// them — hence no slot content.

// Cross-document morph target. The body's first image (page.image) gets the same
// view-transition-name as the list card thumbnail that links here, so clicking a
// card morphs the thumbnail into that image in place — no separate hero, so the
// body's image sequence is untouched. PageContent applies the name to the first
// image block whose URL matches; pages whose image is the Cosense thumbnail (not
// in the body) match nothing and simply cross-fade.
const morphName = page.image ? vtName(page.slug) : undefined;
// HAnDA: ナビに載っているページは共通見出し、詳細ページは一覧へ戻るリンク
const navSection = (await loadSections()).find((s) => s.entry?.data.slug === page.slug);
const back = await backLinkFor(page.tags);
// 活動・成果のページは日付を出さない
const isWorks = await isWorksPage(entry);
// HAnDA: 概要ページ（handa.config.ts の home.about）の下に、続けて載せるページ（半田市とは・赤レンガ建物とは など）。
// Cosense で #about/番号 タグを付けたページ（lib/about.ts）
const aboutMore = page.title === handaConfig.home.about ? await loadAboutMore() : [];
const isAbout = page.title === handaConfig.home.about;
// 概要ページの目次（ページ内の各項目へ）
const aboutToc = isAbout ? [page.title, ...aboutMore.map((e) => e.data.title)] : [];
// 追加の項目は、最初の写真を見出しの下に大きく出し、本文からは外す
const withoutCover = (e: CollectionEntry<"pages">) =>
  e.data.image ? (e.data.blocks as unknown as { type: string; url?: string }[]).filter((b) => !(b.type === "image" && b.url === e.data.image)) : e.data.blocks;
const num = (i: number) => String(i).padStart(2, "0");
---
<Layout title={page.title} description={page.summary} image={page.image} ogType="article" sourceUrl={page.sourceUrl}>
  <article data-pagefind-body>
    <BackLink back={back} />
    {navSection ? (
      <SectionHeader en={navSection.en} title={page.title} />
    ) : (
    <header class="page-header">
      {page.draft && <span class="draft-badge">Draft · preview only</span>}
      {/* `page-title` is set here (not on .page-header h1 globally) so it only
          pairs detail page → detail page; list headers ("Posts", "#tag") don't
          carry it, avoiding a flickery text-to-text cross-fade on list → detail. */}
      <h1 style="view-transition-name: page-title">{page.title}</h1>
      {!isWorks && (
        <PageMeta
          tags={page.tags}
          publishedAt={page.publishedAt}
        />
      )}
    </header>
    )}

    {aboutToc.length > 1 && (
      <nav class="about-toc" aria-label="このページの項目" data-pagefind-ignore>
        <p class="about-toc-label">Contents</p>
        <ol>
          {aboutToc.map((t, i) => (
            <li>
              <a href={`#${encodeURIComponent(i === 0 ? "about-top" : t)}`}>
                <span class="about-toc-num">{num(i + 1)}</span>
                <span class="about-toc-text">{t}</span>
                <span class="about-toc-arrow" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div id="about-top" class:list={{ "about-main": isAbout }}>
      <PageContent blocks={page.blocks} morphName={morphName} morphImageUrl={page.image} />
    </div>

    {aboutMore.map((e, i) => (
      <section class="about-more" id={e.data.title}>
        <header class="about-more-head">
          <span class="about-more-num" aria-hidden="true">{num(i + 2)}</span>
          <h2 class="about-more-title">{e.data.title}</h2>
        </header>
        {e.data.image && (
          <figure class="about-more-cover"><img src={e.data.image} alt="" loading="lazy" decoding="async" /></figure>
        )}
        <PageContent blocks={withoutCover(e) as never} />
      </section>
    ))}

    {!isAbout && <Backlinks backlinks={page.backlinks} />}

    {!isAbout && <Related title={page.title} links={page.links} exclude={page.backlinks} />}

    {/* HAnDA: Cosense の元ページへのリンクはフッターに出す（Layout の sourceUrl） */}
  </article>
</Layout>

<style>
  /* 概要ページ：目次。枠やボタンにせず、本文の各項目（大きな赤い番号＋見出し）と
     同じ形の一覧にして、ページになじませる */
  .about-toc {
    margin: -0.75rem 0 3rem;
  }
  .about-toc-label {
    margin: 0 0 0.4rem;
    font-family: "Oswald", var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .about-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
  }
  .about-toc li { border-bottom: 1px solid var(--color-divider); }
  .about-toc a {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding: 0.75rem 0.15rem;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .about-toc-num {
    font-family: "Oswald", var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }
  .about-toc-text { flex: 1; transition: color 0.15s var(--ease); }
  .about-toc-arrow {
    font-size: 0.85rem;
    color: var(--color-text-faint);
    transition: transform 0.2s var(--ease), color 0.15s var(--ease);
  }
  .about-toc a:hover { text-decoration: none; }
  .about-toc a:hover .about-toc-text { color: var(--color-accent); }
  .about-toc a:hover .about-toc-arrow { color: var(--color-accent); transform: translateY(3px); }
  /* スマホ：1列。右端の↓を丸で囲んで「押すとそこへ飛ぶ」ことが分かるようにし、
     押した瞬間は行がうっすら色づいて↓が下に動く */
  @media (max-width: 720px) {
    .about-toc ol { grid-template-columns: 1fr; }
    .about-toc a {
      padding: 0.8rem 0.25rem;
      -webkit-tap-highlight-color: transparent;
      transition: background 0.15s var(--ease);
    }
    .about-toc-arrow {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      color: var(--color-accent);
      font-size: 0.8rem;
    }
    .about-toc a:active { background: var(--color-accent-soft); }
    .about-toc a:active .about-toc-text { color: var(--color-accent); }
    .about-toc a:active .about-toc-arrow { transform: translateY(3px); border-color: var(--color-accent); }
  }
  .about-main { scroll-margin-top: 5rem; }

  /* 概要ページ：追加の項目（学生チャレンジプロジェクト・半田市・赤レンガ建物 など） */
  .about-more {
    margin-top: 4rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .about-more-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .about-more-num {
    font-family: "Oswald", var(--font-sans);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }
  .about-more-title {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .about-more-cover {
    margin: 0 0 1.75rem;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: var(--color-bg-soft);
  }
  .about-more-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }
  @media (max-width: 720px) {
    .about-more { margin-top: 3rem; padding-top: 2rem; }
    .about-more-num { font-size: 1.6rem; }
    .about-more-title { font-size: 1.25rem; }
    .about-more-cover { aspect-ratio: 16 / 9; }
  }
</style>
