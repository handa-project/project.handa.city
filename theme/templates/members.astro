---
// /members — 各メンバーが Cosense に作った個人ページを自動で集約する。
// 年度のプルダウンで切り替えて表示（最初は最新年度）。複数年度にいる人も 1 人 1 枚のカードで、
// 同じ人が同時に 2 回出ることはない。
//
// メンバーページの書き方（Cosense 側）:
//   - タイトル = 名前
//   - 本文 1 行目 = 一言（役割・所属など）→ カードの説明文になる
//   - 写真を貼ると最初の 1 枚がカード画像になる
//   - タグ: #publish #member/2026 （複数年度なら #member/2025 #member/2026 と並べる）
//
// 並び順（くわしくは handa.config.ts の members）:
//   学科ごとに見出しを付けてまとめる
//   学科の中は 役職（#role/代表 #role/副代表）→ 学年の高い順 → 名前順（#yomi/すずきしょうま）
//   学科・学年は本文 1 行目（「情報科学科 ３年」など）から読み取る。
//   読み取れないときや変えたいときは #dept/情報科学科 #grade/3 のタグで指定できる
//   ※ / の入ったタグはサイト上には表示されない
import { path } from "@cosense-site-kit/theme-utils";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BackLink from "../components/BackLink.astro";
import YearPicker from "../components/YearPicker.astro";
import { homeBack } from "../lib/sections";
import { sectionInfo } from "../lib/sections";
import { loadMembers, deptRank, displayName, OTHER_DEPT } from "../lib/members";

const info = await sectionInfo("members");

const members = await loadMembers();

// 学科ごとにまとめる（並び順は handa.config.ts の departments、無い学科は後ろに）
const groups = [...new Set(members.map((m) => m.dept))]
  .sort((a, b) => deptRank(a) - deptRank(b) || a.localeCompare(b, "ja"))
  .map((dept) => ({ dept, members: members.filter((m) => m.dept === dept) }));
const showHeadings = groups.length > 1 || groups[0]?.dept !== OTHER_DEPT;

const allYears = [...new Set(members.flatMap((m) => m.years))].sort((a, b) => Number(b) - Number(a));
const latest = allYears[0];

---

<Layout title={info.ja} description={info.intro} hideToc>
  <article class="members" data-pagefind-body>
    <BackLink back={homeBack()} />
    <SectionHeader en={info.en} title={info.ja} lead={info.intro} />

    {members.length === 0 && <p class="members-empty">まだメンバーが登録されていません。</p>}

    {allYears.length > 0 && (
      <div class="year-filter" data-pagefind-ignore>
        <YearPicker
          id="members-year"
          label="年度で絞り込み"
          value={latest}
          options={[
            ...allYears.map((y) => ({ value: y, label: `${y}年度` })),
            ...(allYears.length > 1 ? [{ value: "", label: "すべての年度" }] : []),
          ]}
        />
      </div>
    )}

    {groups.map((g) => (
      <section class="member-group" data-dept={g.dept} hidden={!g.members.some((m) => m.years.includes(latest))}>
        {showHeadings && <h2 class="member-group-title">{g.dept}</h2>}
        <ul class="members-grid">
          {g.members.map(({ entry, years, role }) => (
            <li data-years={`|${years.join("|")}|`} hidden={!years.includes(latest)}>
              <a href={path(entry.data.slug)} class="member-card">
                {entry.data.image
                  ? <img src={entry.data.image} alt="" loading="lazy" decoding="async" />
                  : (
                    // 写真が無いときは人型のアイコン
                    <span class="member-initial" aria-hidden="true">
                      <svg viewBox="0 0 64 64" fill="currentColor">
                        <circle cx="32" cy="24" r="11" />
                        <path d="M10 60c0-12.2 9.8-21 22-21s22 8.8 22 21z" />
                      </svg>
                    </span>
                  )}
                <span class="member-text">
                  <span class="member-name">{displayName(entry.data.title)}{role && <span class="member-badge">{role}</span>}</span>
                  {entry.data.summary && <span class="member-summary">{entry.data.summary}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>

<script>
  // 年度のプルダウン（components/YearPicker.astro）で選んだ年度のメンバーだけを出す
  const picker = document.querySelector<HTMLElement>("#members-year");
  const cards = document.querySelectorAll<HTMLElement>(".members-grid > li");
  const show = (year: string) => {
    cards.forEach((c) => {
      c.hidden = Boolean(year) && !(c.dataset.years ?? "").includes(`|${year}|`);
    });
    // その年度に誰もいない学科は見出しごと隠す
    document.querySelectorAll<HTMLElement>(".member-group").forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>(".members-grid > li")].some((c) => !c.hidden);
    });
  };
  picker?.addEventListener("yearpick", (e) => {
    const year = (e as CustomEvent<string>).detail;
    show(year);
    history.replaceState(null, "", year ? `#y${year}` : "#all");
  });
  // URL の #y2025 / #all で年度を指定して開ける
  const m = location.hash.match(/^#y(\d{4})$/);
  const initial = m ? m[1] : location.hash === "#all" ? "" : null;
  if (picker && initial !== null && picker.querySelector(`[data-value="${initial}"]`)) {
    picker.dispatchEvent(new CustomEvent("yearpick:set", { detail: initial }));
    show(initial);
  }
</script>

<style>
  /* 年度のプルダウン（components/YearPicker.astro） */
  .year-filter { margin: -0.5rem 0 2rem; }

  /* 学科ごとのまとまり */
  .member-group + .member-group { margin-top: 2rem; }
  .member-group[hidden] { display: none; }
  .member-group-title {
    margin: 0 0 0.75rem;
    padding-left: 0.6rem;
    border-left: 3px solid var(--color-accent);
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* コンパクトな一覧：左に小さい丸写真、右に名前と一言 */
  .members-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.6rem;
  }
  .members-grid > li[hidden] { display: none; }
  .member-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s var(--ease), border-color 0.15s var(--ease);
    height: 100%;
  }
  .member-card:hover { background: var(--color-bg-hover); border-color: var(--color-accent); text-decoration: none; }
  .member-card img,
  .member-initial {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-bg-soft);
  }
  .member-initial {
    display: grid;
    place-items: end center;
    overflow: hidden;
    color: var(--color-text-faint);
  }
  .member-initial svg {
    width: 78%;
    height: 78%;
  }
  .member-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .member-name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .member-badge {
    flex: none;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-family: "Oswald", var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .member-summary {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .members-empty { color: var(--color-text-muted); }

  /* スマホ：2 列に並べる。カードは縦向き（上に丸写真、下に名前と一言） */
  @media (max-width: 560px) {
    .members-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
    .member-card {
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 0.5rem;
      padding: 0.9rem 0.6rem 0.8rem;
      text-align: center;
    }
    .member-card img,
    .member-initial { width: 56px; height: 56px; }
    .member-text { width: 100%; align-items: center; }
    .member-name { flex-wrap: wrap; justify-content: center; gap: 0.2rem 0.4rem; font-size: 0.92rem; }
    .member-summary {
      font-size: 0.72rem;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
