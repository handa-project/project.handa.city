---
// /members — 各メンバーが Cosense に作った個人ページを自動で集約する。
// 年度タブで切り替えて表示（最初は最新年度）。複数年度にいる人も 1 人 1 枚のカードで、
// 同じ人が同時に 2 回出ることはない。
//
// メンバーページの書き方（Cosense 側）:
//   - タイトル = 名前
//   - 本文 1 行目 = 一言（役割・所属など）→ カードの説明文になる
//   - 写真を貼ると最初の 1 枚がカード画像になる
//   - タグ: #publish #member/2026 （複数年度なら #member/2025 #member/2026 と並べる）
//
// 並び順（くわしくは handa.config.ts の members）:
//   学科ごとに見出しを付けてまとめる
//   学科の中は 役職（#role/代表 #role/副代表）→ 学年の高い順 → 名前順（#yomi/すずきしょうま）
//   学科・学年は本文 1 行目（「情報科学科 ３年」など）から読み取る。
//   読み取れないときや変えたいときは #dept/情報科学科 #grade/3 のタグで指定できる
//   ※ / の入ったタグはサイト上には表示されない
import { getCollection } from "astro:content";
import { path } from "@cosense-site-kit/theme-utils";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BackLink from "../components/BackLink.astro";
import { homeBack } from "../lib/sections";
import { MEMBER_TAG, sectionInfo } from "../lib/sections";
import { handaConfig } from "../lib/config";

const info = await sectionInfo("members");

// ---- 並び順の材料 ------------------------------------------------------------
const memberCfg = handaConfig.members ?? {};
const DEPT_ORDER = memberCfg.departments ?? [];
const ROLE_ORDER = memberCfg.roles ?? ["代表", "副代表"];
const OTHER_DEPT = "その他";

const tagValue = (tags: string[], ...prefixes: string[]) => {
  for (const prefix of prefixes) {
    const t = tags.find((t) => t.toLowerCase().startsWith(`${prefix.toLowerCase()}/`));
    if (t) return t.slice(prefix.length + 1).trim() || undefined;
  }
  return undefined;
};

// 学年を数値に（大きいほど上の学年）。D1〜 > M1〜 > 4年〜1年 > 不明
function gradeRank(raw?: string): number {
  if (!raw) return 0;
  const t = raw.normalize("NFKC").trim();
  let m = t.match(/^(?:D|博士)\s*(\d)/i);
  if (m) return 300 + Number(m[1]);
  m = t.match(/^(?:M|修士)\s*(\d)/i);
  if (m) return 200 + Number(m[1]);
  m = t.match(/^B?\s*(\d)\s*(?:年)?$/i);
  if (m) return 100 + Number(m[1]);
  return 0;
}

// 本文 1 行目（例：「情報科学科 ３年」「大学院経情科 １年」）から学科と学年を読み取る（タグが無いとき用）
function fromSummary(summary?: string): { dept?: string; grade: number } {
  const t = (summary ?? "").normalize("NFKC").trim();
  const m = t.match(/^(.*?)\s*(M|D|修士|博士)?\s*(\d)\s*年/i);
  if (!m) return { grade: 0 };
  const dept = m[1].replace(/[\/／|｜・,、]\s*$/, "").trim() || undefined;
  const n = Number(m[3]);
  const kind = (m[2] ?? "").toUpperCase();
  const grad = kind === "D" || kind === "博士" ? 300 : kind === "M" || kind === "修士" || /大学院|研究科/.test(dept ?? "") ? 200 : 100;
  return { dept, grade: grad + n };
}

const pages = await getCollection("pages");

// 1 人 1 件。その人の在籍年度・学科・学年・読み方・役職を持たせる
const members = pages
  .map((entry) => {
    const tags = entry.data.tags;
    const years = [
      ...new Set(tags.map((t) => t.match(MEMBER_TAG)?.[1]).filter((y): y is string => Boolean(y))),
    ].sort();
    const legacyLeader = tags.some((t) => ["member/leader", "role/leader"].includes(t.toLowerCase()));
    const role = tagValue(tags, "role", "役職") ?? (legacyLeader ? "LEADER" : undefined);
    const roleIdx = role ? ROLE_ORDER.indexOf(role) : -1;
    const guess = fromSummary(entry.data.summary);
    return {
      entry,
      years,
      dept: tagValue(tags, "dept", "学科") ?? guess.dept ?? OTHER_DEPT,
      grade: gradeRank(tagValue(tags, "grade", "学年")) || guess.grade,
      yomi: (tagValue(tags, "yomi", "よみ") ?? entry.data.title).normalize("NFKC"),
      role,
      roleRank: role ? (roleIdx >= 0 ? ROLE_ORDER.length - roleIdx : 1) : 0,
    };
  })
  .filter((m) => m.years.length > 0)
  .sort(
    (a, b) =>
      b.roleRank - a.roleRank ||
      b.grade - a.grade ||
      a.yomi.localeCompare(b.yomi, "ja") ||
      a.entry.data.title.localeCompare(b.entry.data.title, "ja"),
  );

// 学科ごとにまとめる（並び順は handa.config.ts の departments、無い学科は後ろに）
const deptRank = (d: string) => {
  if (d === OTHER_DEPT) return 10_000;
  const i = DEPT_ORDER.indexOf(d);
  return i >= 0 ? i : 1_000;
};
const groups = [...new Set(members.map((m) => m.dept))]
  .sort((a, b) => deptRank(a) - deptRank(b) || a.localeCompare(b, "ja"))
  .map((dept) => ({ dept, members: members.filter((m) => m.dept === dept) }));
const showHeadings = groups.length > 1 || groups[0]?.dept !== OTHER_DEPT;

const allYears = [...new Set(members.flatMap((m) => m.years))].sort((a, b) => Number(b) - Number(a));
const latest = allYears[0];

---

<Layout title={info.ja} description={info.intro} hideToc>
  <article class="members" data-pagefind-body>
    <BackLink back={homeBack()} />
    <SectionHeader en={info.en} title={info.ja} lead={info.intro} />

    {members.length === 0 && <p class="members-empty">まだメンバーが登録されていません。</p>}

    {allYears.length > 0 && (
      <div class="year-tabs" role="tablist" aria-label="年度" data-pagefind-ignore>
        {allYears.map((y) => (
          <button type="button" role="tab" class:list={["year-tab", { "is-active": y === latest }]} data-year={y} aria-selected={y === latest ? "true" : "false"}>
            {y}
          </button>
        ))}
        {allYears.length > 1 && (
          <button type="button" role="tab" class="year-tab" data-year="" aria-selected="false">ALL</button>
        )}
      </div>
    )}

    {groups.map((g) => (
      <section class="member-group" data-dept={g.dept} hidden={!g.members.some((m) => m.years.includes(latest))}>
        {showHeadings && <h2 class="member-group-title">{g.dept}</h2>}
        <ul class="members-grid">
          {g.members.map(({ entry, years, role }) => (
            <li data-years={`|${years.join("|")}|`} hidden={!years.includes(latest)}>
              <a href={path(entry.data.slug)} class="member-card">
                {entry.data.image
                  ? <img src={entry.data.image} alt="" loading="lazy" decoding="async" />
                  : (
                    // 写真が無いときは人型のアイコン
                    <span class="member-initial" aria-hidden="true">
                      <svg viewBox="0 0 64 64" fill="currentColor">
                        <circle cx="32" cy="24" r="11" />
                        <path d="M10 60c0-12.2 9.8-21 22-21s22 8.8 22 21z" />
                      </svg>
                    </span>
                  )}
                <span class="member-text">
                  <span class="member-name">{entry.data.title}{role && <span class="member-badge">{role}</span>}</span>
                  {entry.data.summary && <span class="member-summary">{entry.data.summary}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".year-tab");
  const cards = document.querySelectorAll<HTMLElement>(".members-grid > li");
  const show = (year: string) => {
    tabs.forEach((t) => {
      const on = t.dataset.year === year;
      t.classList.toggle("is-active", on);
      t.setAttribute("aria-selected", String(on));
    });
    cards.forEach((c) => {
      c.hidden = Boolean(year) && !(c.dataset.years ?? "").includes(`|${year}|`);
    });
    // その年度に誰もいない学科は見出しごと隠す
    document.querySelectorAll<HTMLElement>(".member-group").forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>(".members-grid > li")].some((c) => !c.hidden);
    });
  };
  tabs.forEach((t) => t.addEventListener("click", () => {
    show(t.dataset.year ?? "");
    history.replaceState(null, "", t.dataset.year ? `#y${t.dataset.year}` : "#all");
  }));
  // URL の #y2025 / #all で年度を指定して開ける
  const m = location.hash.match(/^#y(\d{4})$/);
  if (m && [...tabs].some((t) => t.dataset.year === m[1])) show(m[1]);
  else if (location.hash === "#all") show("");
</script>

<style>
  .year-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.5rem 0 2rem;
  }
  .year-tab {
    padding: 0.35rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-soft);
    font-family: "Oswald", var(--font-sans);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .year-tab:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .year-tab.is-active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  /* 学科ごとのまとまり */
  .member-group + .member-group { margin-top: 2rem; }
  .member-group[hidden] { display: none; }
  .member-group-title {
    margin: 0 0 0.75rem;
    padding-left: 0.6rem;
    border-left: 3px solid var(--color-accent);
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* コンパクトな一覧：左に小さい丸写真、右に名前と一言 */
  .members-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.6rem;
  }
  .members-grid > li[hidden] { display: none; }
  .member-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s var(--ease), border-color 0.15s var(--ease);
    height: 100%;
  }
  .member-card:hover { background: var(--color-bg-hover); border-color: var(--color-accent); text-decoration: none; }
  .member-card img,
  .member-initial {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-bg-soft);
  }
  .member-initial {
    display: grid;
    place-items: end center;
    overflow: hidden;
    color: var(--color-text-faint);
  }
  .member-initial svg {
    width: 78%;
    height: 78%;
  }
  .member-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .member-name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .member-badge {
    flex: none;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-family: "Oswald", var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .member-summary {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .members-empty { color: var(--color-text-muted); }
</style>
